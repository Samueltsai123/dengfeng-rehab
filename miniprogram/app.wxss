page { background: #f5f7fa; color: #17324d; font-size: 30rpx; }
view, text, input, textarea, button, picker { box-sizing: border-box; }
.page { padding: 28rpx 28rpx 60rpx; }
.brand-logo { display: block; width: 100%; height: 360rpx; background: #fff; border-radius: 20rpx; margin-bottom: 20rpx; }
.hero { padding: 36rpx; border-radius: 24rpx; background: #114a82; color: #fff; margin-bottom: 24rpx; }
.hero-title { font-size: 42rpx; font-weight: 700; }
.hero-sub { font-size: 26rpx; opacity: .9; margin-top: 10rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 22rpx; box-shadow: 0 4rpx 20rpx rgba(13,52,91,.05); }
.section-title { font-size: 34rpx; font-weight: 700; margin: 14rpx 0 20rpx; }
.label { color: #57708a; font-size: 26rpx; margin: 20rpx 0 10rpx; display: block; }
.hint { color: #6b7f90; font-size: 24rpx; line-height: 1.5; }
.empty { color: #718497; text-align: center; padding: 50rpx 20rpx; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.wrap { flex-wrap: wrap; }
.title { font-weight: 700; font-size: 32rpx; }
.muted { color: #6b7f90; font-size: 26rpx; }
.strong { color: #b63e48; font-weight: 700; }
.field { min-height: 84rpx; border: 2rpx solid #dce6ee; border-radius: 12rpx; padding: 20rpx; background: #fff; width: 100%; }
.textarea { min-height: 190rpx; }
.picker { border: 2rpx solid #dce6ee; border-radius: 12rpx; padding: 22rpx; min-height: 84rpx; }
.btn { background: #1263a6; color: #fff; border-radius: 12rpx; margin: 18rpx 0 0; font-size: 30rpx; }
.btn::after { border: none; }
.btn-secondary { background: #e8f1f9; color: #165587; }
.btn-danger { background: #fff1f1; color: #a7383f; }
.btn-small { font-size: 26rpx; padding: 0 20rpx; line-height: 66rpx; margin: 0; }
.grid { display: flex; gap: 16rpx; }
.grid > * { flex: 1; }
.tabs { display: flex; gap: 14rpx; margin: 18rpx 0; }
.tab { padding: 14rpx 20rpx; border-radius: 12rpx; background: #e7eef5; color: #356181; font-size: 26rpx; }
.tab-on { background: #1263a6; color: #fff; }
.chip { display: inline-block; border-radius: 12rpx; padding: 10rpx 16rpx; background: #edf4fa; color: #1b5b88; margin: 6rpx 8rpx 6rpx 0; font-size: 26rpx; }
.chip-on { background: #1263a6; color: #fff; }
.divider { height: 1rpx; background: #e6edf3; margin: 24rpx 0; }
.status { font-size: 24rpx; color: #1c698d; background: #e7f3f5; border-radius: 100rpx; padding: 8rpx 14rpx; }
.error { color: #b63e48; font-size: 26rpx; margin: 12rpx 0; }
.gap { height: 16rpx; }
