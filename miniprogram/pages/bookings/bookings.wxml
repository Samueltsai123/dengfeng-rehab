<view class="page"><view class="section-title">我的预约</view><view wx:if="{{!items.length}}" class="empty">暂无预约记录</view><view wx:for="{{items}}" wx:key="id" class="card"><view class="row"><text class="title">{{item.projectName}}</text><text class="status">{{item.statusText}}</text></view><view class="muted">{{item.date}} {{item.startText}}—{{item.endText}}</view><view class="muted">{{item.therapistName}}</view><button wx:if="{{item.canCancel}}" class="btn btn-danger" data-id="{{item.id}}" bindtap="cancel">取消预约</button><button wx:if="{{item.status==='checkedIn'}}" class="btn btn-secondary" data-id="{{item.id}}" bindtap="log">查看训练记录</button></view><button wx:if="{{hasMore}}" class="btn btn-secondary" bindtap="more" loading="{{loading}}">加载更多</button></view>