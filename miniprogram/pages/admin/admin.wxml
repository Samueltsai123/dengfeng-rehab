<view class="page"><image class="brand-logo" src="/assets/dengfeng_logo.jpg" mode="aspectFill"/><view class="hero"><view class="hero-title">预约管理</view><view class="hero-sub">查看当天预约与处理异常</view></view><view wx:if="{{therapists.length===1}}" class="card"><view class="title">首次使用</view><view class="hint">先建立五位教练目录，再配置实际账号、服务项目和排班。</view><button class="btn" bindtap="seedCatalog">初始化人员目录</button></view><view class="grid"><button class="btn btn-secondary" bindtap="profiles">学员管理</button><button class="btn btn-secondary" bindtap="staff">人员与排班</button></view><button class="btn btn-secondary" bindtap="notifications">签到通知状态</button><button class="btn btn-secondary" bindtap="cleanupMedia">清理未引用图片</button><view wx:if="{{showNotifications}}" class="card"><view class="title">近期签到通知</view><view wx:if="{{!notifications.length}}" class="hint">暂无通知记录</view><view wx:for="{{notifications}}" wx:key="bookingId" class="muted">{{item.bookingId}} · {{item.statusText}} · {{item.updatedAt}}</view></view><view class="card"><text class="label">日期</text><picker mode="date" value="{{date}}" bindchange="changeDate"><view class="picker">{{date}}</view></picker><text class="label">教练</text><picker range="{{therapists}}" range-key="name" value="{{therapistIndex}}" bindchange="changeTherapist"><view class="picker">{{therapists[therapistIndex].name}}</view></picker></view><view wx:if="{{!items.length}}" class="empty">该日暂无预约</view><view wx:for="{{items}}" wx:key="id" class="card"><view class="row"><text class="title">{{item.studentName}} · {{item.projectName}}</text><text class="status">{{item.statusText}}</text></view><view class="muted">{{item.startText}}—{{item.endText}} · {{item.therapistName}}</view><button class="btn btn-secondary" data-id="{{item.studentId}}" bindtap="profile">学员详情</button><button wx:if="{{item.canSignin}}" class="btn" data-id="{{item.id}}" disabled="{{busyId!==''}}" bindtap="signin">兜底签到</button><button wx:if="{{item.status==='booked'}}" class="btn btn-danger" data-id="{{item.id}}" disabled="{{busyId!==''}}" bindtap="cancel">取消预约</button><button wx:if="{{item.status==='checkedIn'}}" class="btn btn-secondary" data-id="{{item.id}}" bindtap="log">查看日志</button><button wx:if="{{item.canUndo}}" class="btn btn-danger" data-id="{{item.id}}" disabled="{{busyId!==''}}" bindtap="undo">撤销误签到</button></view><button wx:if="{{hasMore}}" class="btn btn-secondary" bindtap="more" loading="{{loading}}">加载更多</button></view>
