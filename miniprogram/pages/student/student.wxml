<view class="page"><image class="brand-logo" src="/assets/dengfeng_logo.jpg" mode="aspectFill"/><view class="hero"><view class="hero-title">登峰运动康复中心</view><view class="hero-sub">{{student.name || '我的康复'}} · 预约与课时</view></view><view class="card"><view class="section-title">我的课时</view><view class="title">剩余 {{student.balance || 0}} 节</view><view class="muted">已预约待签到 {{student.held || 0}} 节 ｜ 可再预约 {{student.available || 0}} 节</view><view wx:if="{{student.available===0}}" class="hint">{{student.balance===0?'课时不足，请联系中心。':'已有预约占用了可约额度。'}}</view></view><view class="card"><view class="row"><view class="section-title">今日预约</view><text class="muted" bindtap="history">我的预约 ›</text></view><view wx:if="{{!today.length}}" class="empty">今天暂无预约</view><view wx:for="{{today}}" wx:key="id"><view class="divider"/><view class="row"><text class="title">{{item.projectName}}</text><text class="status">{{item.statusText}}</text></view><view class="muted">{{item.startText}}—{{item.endText}} · {{item.therapistName}}</view></view></view><button class="btn" bindtap="book">预约课程</button><button class="btn btn-secondary" bindtap="profile">我的档案</button></view>
