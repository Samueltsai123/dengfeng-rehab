<view class="page"><view class="section-title">{{role==='admin'?'学员管理':'学员档案'}}</view><view class="card"><input class="field" value="{{query}}" bindinput="input" confirm-type="search" bindconfirm="load" placeholder="姓名或手机号"/><button class="btn btn-secondary" bindtap="load">搜索</button></view><button class="btn" bindtap="create">代建学员档案</button><view wx:if="{{!items.length &amp;&amp; !loading}}" class="empty">暂无匹配学员</view><view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id || item._id}}" bindtap="open"><view class="row"><text class="title">{{item.name}}</text><text class="muted">查看 ›</text></view><view class="muted">{{item.phone}}</view></view><button wx:if="{{hasMore}}" class="btn btn-secondary" bindtap="more" loading="{{loading}}">加载更多</button></view>