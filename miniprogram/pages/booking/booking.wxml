<view class="page"><view class="card"><view class="row"><view class="section-title">预约课程</view><text class="muted" bindtap="history">我的预约 ›</text></view><text class="label">教练</text><picker range="{{therapists}}" range-key="name" bindchange="selectTherapist"><view class="picker">{{therapistIndex&lt;0?'选择教练':therapists[therapistIndex].name}}</view></picker><text class="label">服务项目</text><picker range="{{projectOptions}}" range-key="name" bindchange="selectProject"><view class="picker">{{projectIndex&lt;0?'选择项目':projectOptions[projectIndex].name}}</view></picker><view class="hint" wx:if="{{projectIndex>=0}}">实际用时 {{projectOptions[projectIndex].durationMinutes || projectOptions[projectIndex].duration}} 分钟</view><text class="label">日期</text><picker mode="date" value="{{date}}" start="{{today}}" bindchange="selectDate"><view class="picker">{{date}}</view></picker><text class="label">可用开始时间</text><view wx:if="{{projectIndex&lt;0}}" class="hint">先选择教练和项目</view><view wx:elif="{{!slots.length}}" class="empty">{{available===0?'可约额度不足，请先查看已有预约或联系中心。':'该日暂无可约时间'}}</view><view wx:else class="wrap"><view wx:for="{{slots}}" wx:key="startMinute" class="chip {{slotIndex===index?'chip-on':''}}" data-index="{{index}}" bindtap="selectSlot">{{item.startText}}—{{item.endText}}</view></view></view><view class="card" wx:if="{{slotIndex>=0}}"><view class="title">确认预约</view><view>{{date}} {{slots[slotIndex].startText}}—{{slots[slotIndex].endText}}</view><view>{{projectOptions[projectIndex].name}} · {{therapists[therapistIndex].name}}</view><view class="hint">预约不扣课；签到后扣 1 节。本次预约将占用 1 节可约额度。</view><button class="btn" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">确认预约</button></view></view>

