<view class="page"><view class="section-title">{{readonly?'训练记录':'填写训练记录'}}</view><view class="card"><view class="title">{{booking.studentName}} · {{booking.projectName}}</view><view class="muted">{{booking.date}} {{booking.startText}}—{{booking.endText}} · {{booking.therapistName}}</view><text class="label">训练反馈</text><textarea class="field textarea" value="{{text}}" disabled="{{readonly}}" maxlength="3000" placeholder="填写本次训练反馈" bindinput="inputText"/><text class="label">图片（选填，最多 3 张）</text><view class="wrap"><view wx:for="{{images}}" wx:key="index" class="card"><image src="{{item.url}}" mode="aspectFill" style="width:180rpx;height:180rpx;border-radius:12rpx" data-url="{{item.url}}" bindtap="preview"/><view class="hint">{{item.status==='failed'?'上传失败':item.status==='uploading'?'上传中':'已上传'}}</view><button wx:if="{{!readonly &amp;&amp; item.status==='failed'}}" class="btn btn-small" data-path="{{item.localPath}}" bindtap="retry">重试</button><button wx:if="{{!readonly}}" class="btn btn-small btn-danger" data-index="{{index}}" bindtap="remove">移除</button></view></view><button wx:if="{{!readonly &amp;&amp; images.length&lt;3}}" class="btn btn-secondary" bindtap="choose">添加图片</button><button wx:if="{{!readonly}}" class="btn" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存日志</button></view></view>
