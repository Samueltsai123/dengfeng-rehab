<view class="page"><image class="brand-logo" src="/assets/dengfeng_logo.jpg" mode="aspectFill"/><view class="hero"><view class="hero-title">今日预约</view><view class="hero-sub">{{therapist.name || '教练'}}的预约安排</view></view><view class="grid"><button class="btn btn-secondary" bindtap="profiles">学员档案</button><button class="btn btn-secondary" bindtap="schedule">我的空闲时间</button></view><view class="card"><text class="label">预约日期</text><picker mode="date" value="{{date}}" bindchange="changeDate"><view class="picker">{{date}}</view></picker></view><view wx:if="{{!items.length}}" class="empty">该日暂无预约</view><view wx:for="{{items}}" wx:key="id" class="card"><view class="row"><text class="title">{{item.studentName}} · {{item.projectName}}</text><text class="status">{{item.statusText}}</text></view><view class="muted">{{item.startText}}—{{item.endText}}</view><button class="btn btn-secondary" data-id="{{item.studentId}}" bindtap="profile">查看档案</button><button wx:if="{{item.canSignin}}" class="btn" data-id="{{item.id}}" disabled="{{busyId!==''}}" bindtap="signin">签到并扣 1 节</button><view wx:if="{{item.status==='booked' &amp;&amp; !item.canSignin}}" class="hint">课程开始后可签到</view><button wx:if="{{item.status==='checkedIn'}}" class="btn" data-id="{{item.id}}" bindtap="log">写日志／查看日志</button></view><button wx:if="{{hasMore}}" class="btn btn-secondary" bindtap="more" loading="{{loading}}">加载更多</button></view>